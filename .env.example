# Backlite server configuration

# Required
ANTHROPIC_API_KEY=sk-ant-...

# Required for codex harness
# OPENAI_API_KEY=sk-...

# GitHub personal access token (for cloning private repos and creating PRs)
GITHUB_TOKEN=ghp_...

# Server
BACKFLOW_LISTEN_ADDR=:8080
BACKFLOW_DATABASE_PATH=./backlite.db

# Local SQLite backups (enabled by default)
# BACKFLOW_LOCAL_BACKUP_ENABLED=true
# BACKFLOW_LOCAL_BACKUP_DIR=~/backlite-backups
# BACKFLOW_LOCAL_BACKUP_INTERVAL_SEC=86400
# BACKFLOW_LOCAL_BACKUP_RETENTION_SEC=604800
# Optional S3-compatible upload of the newest valid local backup
# BACKFLOW_BACKUP_S3_BUCKET=backlite-backups
# BACKFLOW_BACKUP_S3_PREFIX=sqlite/
# BACKFLOW_BACKUP_S3_REGION=us-east-1
# BACKFLOW_BACKUP_S3_ENDPOINT=
# BACKFLOW_BACKUP_S3_PATH_STYLE=false

# Agent image (set this if you publish a non-default tag; use backlite-fake-agent for local blackbox/soak testing)
# BACKFLOW_AGENT_IMAGE=backlite-fake-agent

# Skill-agent image (opt-in; claude_code-only)
# When set, every claude_code task is routed to this image. Codex tasks continue
# to use BACKFLOW_AGENT_IMAGE.
# Unset to roll back instantly. See CLAUDE.md "Skill-based agent image" for details.
# BACKFLOW_SKILL_AGENT_IMAGE=backlite-skill-agent

# Concurrency (cap is <= 6; see internal/config/config.go)
BACKFLOW_MAX_CONTAINERS=1

# Container resources
BACKFLOW_CONTAINER_CPUS=2
BACKFLOW_CONTAINER_MEMORY_GB=8

# Agent defaults
# BACKFLOW_DEFAULT_HARNESS=claude_code
BACKFLOW_DEFAULT_EFFORT=xhigh
BACKFLOW_DEFAULT_CLAUDE_MODEL=claude-opus-4-7
BACKFLOW_DEFAULT_CODEX_MODEL=gpt-5.4
BACKFLOW_DEFAULT_MAX_BUDGET=10
BACKFLOW_DEFAULT_MAX_RUNTIME_SEC=1800
BACKFLOW_DEFAULT_MAX_TURNS=200
BACKFLOW_DEFAULT_CREATE_PR=true
BACKFLOW_DEFAULT_SELF_REVIEW=false
BACKFLOW_DEFAULT_SAVE_AGENT_OUTPUT=true

# Webhooks (optional)
# BACKFLOW_WEBHOOK_URL=https://hooks.slack.com/services/...
# BACKFLOW_WEBHOOK_EVENTS=task.needs_input,task.failed,task.completed

# Retry
# BACKFLOW_MAX_USER_RETRIES=2

# Orchestrator
BACKFLOW_POLL_INTERVAL_SEC=5
